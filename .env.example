# ==============================================================================
# EMAIL DELIVERY CONFIGURATION (CHOOSE ONE OPTION TO SEND TO EVERYONE)
# ==============================================================================

# OPTION 1: Resend (Requires adding & verifying your custom domain at https://resend.com/domains)
RESEND_API_KEY=your_resend_api_key_here
# Once your domain is verified on Resend, change onboarding@resend.dev to your verified domain:
RESEND_FROM_EMAIL=RealCRM <noreply@yourdomain.com>

# OPTION 2: Standard SMTP / Gmail (Sends to ANY email in the world WITHOUT needing a domain)
# Generate a 16-char App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-google-app-password
# SMTP_FROM=RealCRM <your-email@gmail.com>
